{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learninghub.local/schemas/ai-flashcards-output-1.json",
  "title": "AIFlashcardsOutput",
  "type": "object",
  "additionalProperties": false,
  "required": ["cards"],
  "properties": {
    "cards": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["front", "back"],
        "properties": {
          "front": { "type": "string", "maxLength": 300 },
          "back": { "type": "string", "maxLength": 2000 }
        }
      }
    }
  }
}
